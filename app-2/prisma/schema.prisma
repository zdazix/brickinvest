generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AppSetting {
  key       String   @id
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  value     Json

  @@map("app_settings")
}

model InvestorSubmission {
  id              String   @id @default(cuid())
  objective       String?
  budget          String?
  opportunityType String?  @map("opportunity_type")
  locations       String?
  timing          String?
  firstName       String   @map("first_name")
  email           String?
  phone           String?
  consent         Boolean  @default(false)
  consentAt       DateTime @map("consent_at") @db.Timestamptz(3)
  submittedAt     DateTime @default(now()) @map("submitted_at") @db.Timestamptz(3)

  @@map("investor_submissions")
}
